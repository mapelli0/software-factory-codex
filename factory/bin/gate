#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job ready runs it)
  gate --preflight <path>  run the platform checks in a worktree without writing a verdict

The gate runs the main checkout's configured platform checks inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch changes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`).
"""

import fnmatch
import json
import subprocess
import sys
import time
from pathlib import Path

from runtime import run_checks as run_platform_checks

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text(encoding="utf-8"))
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, encoding="utf-8", errors="replace")
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree, base):
    """Files changed under protected_paths."""
    diff = git(worktree, "diff", "--name-status", "-z", base, "HEAD")
    fields = iter(diff.rstrip("\0").split("\0")) if diff else iter(())
    hits = []
    for status in fields:
        path = next(fields)
        paths = [path, next(fields)] if status.startswith(("R", "C")) else [path]
        for changed in paths:
            if any(fnmatch.fnmatchcase(changed, pattern) for pattern in CONFIG["protected_paths"]):
                hits.append(f"{status[0]} {changed}")
    return hits


def run_checks(worktree):
    start = time.monotonic()
    try:
        res = run_platform_checks(FACTORY, CONFIG, worktree)
    except OSError as error:
        die(str(error))
    return res.returncode, res.stdout, int(time.monotonic() - start)


def gate(job_id, merge):
    if not job_id or any(c not in "0123456789abcdefghijklmnopqrstuvwxyz-" for c in job_id):
        die("invalid job ID")
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text(encoding="utf-8"))
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    target = job.get("base_commit") or f"origin/{CONFIG['base_branch']}"
    base = git(worktree, "merge-base", target, commit).strip()
    protected = protected_changes(worktree, base)
    if git(worktree, "status", "--porcelain").strip():
        die("worktree must be clean before the gate")
    code, log, seconds = run_checks(worktree)
    if git(worktree, "status", "--porcelain").strip() or git(worktree, "rev-parse", "HEAD").strip() != commit:
        code = code or 1
        log += "\nFactory checks changed the worktree or commit.\n"
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log, encoding="utf-8")
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"platform checks {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", final checks before handoff" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\nBASE: {base}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## Platform checks\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n", encoding="utf-8"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, platform checks exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def main(argv):
    if len(argv) == 2 and argv[0] == "--preflight":
        code, log, _ = run_checks(Path(argv[1]).resolve())
        print(log, end="")
        sys.exit(code)
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    main(sys.argv[1:])
