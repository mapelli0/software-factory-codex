#!/usr/bin/env python3
"""Print this installation's configured stage and reviewer models."""

import json
import sys
from pathlib import Path


def main():
    if len(sys.argv) != 1:
        sys.exit("usage: models")
    path = Path(__file__).resolve().parents[1] / "config.json"
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
        models = {key: config.get(key, {}) for key in ("agent_models", "routing", "surface_reviewers")}
        print(json.dumps(models, indent=2))
    except (OSError, ValueError, AttributeError) as error:
        sys.exit(f"models: {error}")


if __name__ == "__main__":
    main()
