#!/usr/bin/env python3
"""Compatibility entry point for explicitly routing accepted intake."""

import subprocess
import sys
from pathlib import Path

def main(argv):
    run_option = []
    if len(argv) == 3 and argv[0] == "--run":
        run_option, argv = argv[:2], argv[2:]
    if len(argv) != 1:
        sys.exit("usage: route [--run <token>] <job-id>")
    return subprocess.call([sys.executable, str(Path(__file__).with_name("job")), *run_option, "route", *argv])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
