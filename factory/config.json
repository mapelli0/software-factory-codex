{
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "agent_models": {
    "intake": "gpt-6.2-astra",
    "intake-conversation": "gpt-6.2-astra",
    "spec-writer": "gpt-6.2-astra",
    "builder": "gpt-6.2-astra",
    "approver": "gpt-6.2-astra"
  },
  "routing": {
    "low": {
      "code": "gpt-6-luna"
    },
    "medium": {
      "code": "gpt-6.2-sol"
    },
    "high": {
      "code": "gpt-6.2-sol"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "gpt-6.2-sol",
      "ui": "gpt-6-luna"
    },
    "security": {
      "security": "gpt-6.2-astra"
    }
  },
  "protected_paths": [
    ".factory/*"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "checks": {
    "windows": {
      "shell": "pwsh",
      "script": "checks.ps1"
    },
    "linux": {
      "shell": "bash",
      "script": "checks.sh"
    }
  }
}
